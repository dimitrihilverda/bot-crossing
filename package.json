{
  "name": "bot-crossing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D colony sim where every coding-agent thread on your machine is a little crew member moving furniture in.",
  "license": "MIT",
  "author": "Jarren Rocks",
  "homepage": "https://botcrossing.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarrenrocks/bot-crossing.git"
  },
  "bugs": {
    "url": "https://github.com/jarrenrocks/bot-crossing/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && node -e \"process.env.PORT=process.env.PORT||'5280';require('child_process').spawn(process.execPath,['node_modules/vite/bin/vite.js'],{stdio:'inherit'}).on('exit',c=>process.exit(c??0))\"",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node -e \"process.env.PORT=process.env.PORT||'5280';import('./server/serve.mjs')\"",
    "serve": "node -e \"process.env.PORT=process.env.PORT||'5280';import('./server/serve.mjs')\"",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "vite": "^7.1.0"
  }
}
