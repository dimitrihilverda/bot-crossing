node_modules
dist

# Your colony: which repo sits on which plot, and what you archived. Holds the names and
# paths of the repos you work in, so it stays out of the repository.
data/*.json
data/*.tmp

# Per-machine Claude Code permissions — personal paths live in here.
.claude/settings.local.json

# Raw asset packs. The built glbs in public/assets are checked in instead — see the README
# under "Where the art comes from" for how to re-fetch these if you need to rebuild.
assets-src

.DS_Store
*.log

# Local capture output — not part of the project.
recordings

# SDD scratch (ledgers, briefs, review packages)
.superpowers

# NUC installer: the operator's filled-in config (holds a Tailscale key) and the generated seed
hub/nuc-image/config.env
hub/nuc-image/build/

# NUC installer: the ISO-build config (account password)
hub/nuc-image/iso.env

# Python bytecode from local testing
__pycache__/

# Windows taakbalk-toggle: per-machine bits that must not be shared.
# The Edge profile (cookies/session), the generated icon preview, and any local override.
startup/browser-profile/
startup/bot-crossing-icon-preview.png
startup/toggle.local.ps1
startup/bot-crossing.vbs
# Het startprogramma wordt door install-toggle.ps1 uit launcher.cs gebouwd; de bron staat
# in git, het bouwsel niet.
startup/*.exe
startup/toggle.log
