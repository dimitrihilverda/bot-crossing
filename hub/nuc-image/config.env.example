# Bot Crossing hub — NUC installer configuration.
#
# Copy this file to `config.env`, fill it in, then run ./build-usb.sh (see README.md).
# config.env is gitignored — it holds a Tailscale auth key, so never commit it.

# --- The NUC account the wall runs under ---------------------------------------------------
BCH_HOSTNAME="bot-crossing-hub"       # machine hostname + default Tailscale name
BCH_USER="hub"                        # login account created on the NUC
BCH_PASSWORD="change-me-please"       # its password (also your SSH login). CHANGE THIS — the
                                      # build refuses to run while it is the default.

# --- The app -------------------------------------------------------------------------------
BCH_REPO_URL="https://github.com/dimitrihilverda/bot-crossing.git"  # public fork; clones w/o creds
BCH_BRANCH="main"
BCH_COLONY_NAME="Hub"                 # the hub's own colony name (it only ever reads others)

# --- Tailscale -----------------------------------------------------------------------------
# Generate a REUSABLE pre-auth key in the Tailscale admin console:
#   https://login.tailscale.com/admin/settings/keys  ->  Generate auth key
#   Make it reusable (so you can re-flash later) and, if you like, non-expiring. Paste it below.
# Leave blank to bring Tailscale up by hand on first boot instead (this breaks "walk away").
TS_AUTHKEY=""

# --- Teammates whose colonies appear on the wall -------------------------------------------
# Comma-separated  Name=tailscale-ip  pairs. Port 5275 (the guest API) is assumed.
# NOTE: each teammate must also have sharing ON and the hub's IP under
#   Settings -> Shared colonies -> "Allow a screen / hub to read me"
# (hub/README.md section 4) or their colony shows nothing on the wall.
BCH_NEIGHBORS="Dimitri=100.x.x.1,Chantal=100.x.x.2"

# --- Network (optional) --------------------------------------------------------------------
# Leave WIFI_* blank for wired ethernet (recommended for an always-on wall display). If set,
# build-usb.sh writes the wifi into the installer's own network config (the install itself needs
# to be online), matching any interface named wl* so the NUC's adapter name doesn't matter.
WIFI_SSID=""
WIFI_PASSWORD=""
