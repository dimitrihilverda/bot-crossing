# Bot Crossing hub — custom-ISO build settings (headless install).
#
# Copy to iso.env and fill in, then run ./build-iso.sh. Unlike the pre-fill config.env, this holds
# NO wifi, NO teammate IPs and NO Tailscale key — those are entered from your phone on first boot.
# It only carries what the OS install itself needs (account) and where to get the app.
#
# iso.env is gitignored.

BCH_HOSTNAME="bot-crossing-hub"
BCH_USER="hub"
BCH_PASSWORD="change-me-please"   # account + SSH password. CHANGE THIS (build refuses the default).

BCH_REPO_URL="https://github.com/dimitrihilverda/bot-crossing.git"   # public fork; no creds needed
BCH_BRANCH="main"

# Optional: path to an Ubuntu Server 24.04 ISO you already downloaded. Leave blank to have
# build-iso.sh download the current 24.04.x LTS live-server ISO itself.
UBUNTU_ISO=""
